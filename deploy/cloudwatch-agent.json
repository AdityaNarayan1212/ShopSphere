{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "ShopSphere/EC2",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": {
        "measurement": [
          "mem_used_percent",
          "mem_available_percent"
        ],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": [
          "used_percent",
          "inodes_free"
        ],
        "metrics_collection_interval": 60,
        "resources": [
          "/"
        ]
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "/shopsphere/nginx",
            "log_stream_name": "{instance_id}-access",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/shopsphere/nginx",
            "log_stream_name": "{instance_id}-error",
            "retention_in_days": 14
          },
          {
            "file_path": "/home/ubuntu/.pm2/logs/api-out.log",
            "log_group_name": "/shopsphere/api",
            "log_stream_name": "{instance_id}-pm2-out",
            "retention_in_days": 14
          },
          {
            "file_path": "/home/ubuntu/.pm2/logs/api-error.log",
            "log_group_name": "/shopsphere/api",
            "log_stream_name": "{instance_id}-pm2-error",
            "retention_in_days": 14
          }
        ]
      }
    }
  }
}
