# Runtime environment ("production" enforces strict startup & seed checks)
NODE_ENV=production

# Local TCP port that Express listens on behind Nginx
PORT=4000

# Number of reverse proxy hops to trust for X-Forwarded-For rate limiting (use 2 behind CloudFront + Nginx)
TRUST_PROXY=2

# Allowed browser CORS origin(s), comma-separated (replace with your CloudFront HTTPS URL)
CLIENT_ORIGIN=https://PLACEHOLDER_CLOUDFRONT_DOMAIN.cloudfront.net

# Private RDS PostgreSQL connection string (SSL enabled)
DATABASE_URL=postgresql://shopsphere:PLACEHOLDER_DB_PASSWORD@PLACEHOLDER_RDS_ENDPOINT.ap-south-1.rds.amazonaws.com:5432/shopsphere?schema=public&sslmode=require

# Cryptographically random JWT signing secret (MUST be at least 32 characters in production)
JWT_SECRET=PLACEHOLDER_GENERATE_WITH_OPENSSL_RAND_BASE64_48

# JWT token lifetime (e.g., 1d, 12h)
JWT_EXPIRES_IN=1d

# AWS region for S3 and SNS clients
AWS_REGION=ap-south-1

# Private S3 bucket name for presigned product image uploads (accessed via EC2 IAM instance role; no access keys)
S3_BUCKET=PLACEHOLDER_S3_BUCKET_NAME

# Optional public/CloudFront base URL for viewing uploaded S3 assets (presign returns publicUrl = ASSETS_BASE_URL + "/" + key)
ASSETS_BASE_URL=https://PLACEHOLDER_ASSETS_CLOUDFRONT_DOMAIN.cloudfront.net

# Optional SNS topic ARN for order placement notifications (leave empty to log notifications to stdout)
SNS_ORDER_TOPIC_ARN=arn:aws:sns:ap-south-1:PLACEHOLDER_AWS_ACCOUNT_ID:PLACEHOLDER_SNS_TOPIC_NAME

# Required custom password when running prisma/seed.ts in production (must NOT be DemoAdmin!234)
SEED_ADMIN_PASSWORD=PLACEHOLDER_STRONG_ADMIN_PASSWORD

# Optional flag to also seed the demo customer account in production (defaults to false in production)
SEED_DEMO_CUSTOMER=false

# Custom password for the demo customer account if SEED_DEMO_CUSTOMER=true (must NOT be DemoUser!234)
SEED_CUSTOMER_PASSWORD=PLACEHOLDER_STRONG_CUSTOMER_PASSWORD
