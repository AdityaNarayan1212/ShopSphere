NODE_ENV=development
PORT=4000
# Number of reverse proxy hops to trust (1 behind Nginx only, 2 behind CloudFront + Nginx)
TRUST_PROXY=1
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://shopsphere:shopsphere_dev@localhost:5432/shopsphere?schema=public
JWT_SECRET=replace-with-a-long-random-secret-before-running
JWT_EXPIRES_IN=1d
AWS_REGION=ap-south-1
S3_BUCKET=
SNS_ORDER_TOPIC_ARN=
SEED_ADMIN_PASSWORD=DemoAdmin!234
SEED_CUSTOMER_PASSWORD=DemoUser!234
SEED_DEMO_CUSTOMER=true
